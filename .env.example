# ====== DeepSeek LLM ======
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ====== MySQL ======
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=customer_service

# ====== Redis ======
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=        # 留空=默认用户；Redis 6.0+ ACL 非 default 用户时填写
REDIS_PASSWORD=
REDIS_DB=0

# ====== Qdrant ======
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=product_faqs

# ====== Embedding (bge-base-zh-v1.5) ======
# 后端：local = 本机加载模型；http = 调用服务器 embedding API
EMBEDDING_BACKEND=local
EMBEDDING_MODEL_PATH=BAAI/bge-base-zh-v1.5
EMBEDDING_DIMENSION=768
# http 后端必填：服务器 embedding 服务地址（SSH 隧道后的本地地址）
EMBEDDING_API_URL=
EMBEDDING_API_PATH=/embed
EMBEDDING_API_KEY=

# ====== Server ======
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
